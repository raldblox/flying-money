{
  "name": "@flying-money/bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Spike: pay ordinary x402 endpoints from a Flying Money budget (self-hosted bridge).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "spike": "tsx spike/base-sepolia.ts"
  },
  "dependencies": {
    "@flying-money/chains": "workspace:*",
    "@flying-money/core": "workspace:*",
    "@flying-money/server": "workspace:*",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "hono": "^4.12.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@flying-money/abi": "workspace:*",
    "@flying-money/client": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@x402/hono": "2.28.0"
  }
}
