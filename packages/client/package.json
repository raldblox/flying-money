{
  "name": "@flying-money/client",
  "version": "0.1.0",
  "description": "Buyer SDK for Flying Money: pay HTTP 402 APIs from a capped USDC budget, with a crash-safe outbox.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raldblox/flying-money.git",
    "directory": "packages/client"
  },
  "homepage": "https://useflyingmoney.vercel.app/docs",
  "bugs": "https://github.com/raldblox/flying-money/issues",
  "keywords": [
    "usdc",
    "payments",
    "ai-agents",
    "http-402",
    "eip-712",
    "arbitrum",
    "budget"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./counter": {
      "types": "./dist/counter-entry.d.ts",
      "import": "./dist/counter-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@flying-money/chains": "workspace:*",
    "@flying-money/core": "workspace:*",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@flying-money/server": "workspace:*",
    "hono": "^4.12.0",
    "@flying-money/abi": "workspace:*"
  },
  "bin": {
    "flying-money": "./dist/cli.js"
  }
}
