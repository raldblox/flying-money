{
  "name": "@flying-money/chains",
  "version": "0.1.0",
  "description": "Chain registry for Flying Money: chain IDs, RPCs, USDC addresses, explorers, deployments and caps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raldblox/flying-money.git",
    "directory": "packages/chains"
  },
  "homepage": "https://useflyingmoney.vercel.app/docs",
  "bugs": "https://github.com/raldblox/flying-money/issues",
  "keywords": [
    "usdc",
    "payments",
    "ai-agents",
    "http-402",
    "eip-712",
    "arbitrum",
    "budget"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "gen": "tsx scripts/gen-registry.ts",
    "check": "tsx scripts/check-chains.ts"
  },
  "dependencies": {
    "viem": "^2.56.8"
  }
}
