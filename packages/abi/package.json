  "description": "ABI of the Flying Money budget contract (FlyingMoney.sol).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raldblox/flying-money.git",
    "directory": "packages/abi"
  },
  "homepage": "https://useflyingmoney.vercel.app/docs",
