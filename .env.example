# Chains: all addresses, chain IDs and RPC defaults come from @flying-money/chains.
# Override RPCs only if needed:
RPC_ARBITRUM_SEPOLIA=
RPC_ARBITRUM=
RPC_BASE_SEPOLIA=
RPC_BASE=
RPC_MONAD_TESTNET=
RPC_MONAD=
RPC_ARC_TESTNET=
RPC_ARC=

DEPLOYER_KEY=                 # forge scripts only; never committed; separate key per network class (testnet/mainnet)
EXPLORER_API_KEYS=            # for forge verify (Arbiscan/Basescan/…); per explorer docs

# Oracle (seller), one payee address for all EVM chains
PAYEE_ADDRESS=
REDEEMER_KEY=                 # needs gas on each chain: ETH (Arbitrum/Base), MON (Monad), USDC (Arc)
ORACLE_ACCEPTS=arbitrum-sepolia,base-sepolia,monad-testnet,arc-testnet
ORACLE_MAINNET_ACCEPTS=arbitrum,base,monad,arc

# Seller store. Upstash (e.g. via the Vercel Marketplace) sets KV_REST_API_URL / KV_REST_API_TOKEN on Vercel; for
# local runs copy them from the Upstash page.
# Read first; the UPSTASH_* names are the fallback. REDIS_URL for any TCP Redis. Memory store if all empty.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
FM_ENV=testnet                # testnet | mainnet (a mainnet seller refuses to start otherwise)
FM_REDIS_PREFIX=              # default fm:v1:${FM_ENV}:
CRON_SECRET=                  # hosted Oracle: authorises /api/cron/redeem (Vercel sends it as a Bearer token)
FM_VERCEL_PLAN=hobby             # hobby (daily cron, 36 h margins) | pro (10-minute cron)
FM_REQUIRE_DURABLE=           # 1 = the local Oracle refuses to start without a durable store
PORT=8787
CORS_ORIGIN=                  # comma-separated; * if empty
ORACLE_DOCS_URL=https://useflyingmoney.vercel.app/docs

# Demo runner
DEMO_FUNDER_KEY=              # holds testnet USDC per chain; mainnet use ≤ 5 USDC total
DEMO_AGENT_KEY=

# Merchant agent (apps/agent). Create the key with: node packages/client/dist/cli.js keygen --out .env (after pnpm build)
AGENT_KEY=
AGENT_CERTIFICATES=           # comma-separated certificate ids issued to the agent
AGENT_CHAIN=arbitrum-sepolia

# Local anvil only (pnpm --filter @flying-money/agent demo:local sets these itself)
FM_ANVIL_USDC=
FM_ANVIL_CONTRACT=
ORACLE_URL=https://flying-money-oracle.vercel.app
NEXT_PUBLIC_DEFAULT_CHAIN=arbitrum-sepolia

# Optional LLM mode
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
